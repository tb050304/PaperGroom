# ============================================================
# PaperGroom config template
# ============================================================
# Usage:
#   1. Copy this file to .env: cp .env.example .env
#   2. Fill in your own real keys in .env
#   3. .env is excluded by .gitignore and will not be committed, so it is safe to put real keys there
#
# Note: This file is only a template. All values are placeholders.
#       Do NOT put real secrets in this file!
# ============================================================

# Choose an LLM provider: ark | openai | local
LLM_PROVIDER=ark

# ---------- Volcengine Ark (recommended) ----------
# Stable access in China; Agent Plan / Coding Plan quotas can lower per-call cost
ARK_API_KEY=your_ark_api_key_here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Model ID or Endpoint ID; available in the Ark console
ARK_MODEL=your_endpoint_id_or_model_name

# ---------- OpenAI ----------
# To use OpenAI, set LLM_PROVIDER=openai and uncomment the lines below
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ---------- Local model (Ollama / vLLM, etc.) ----------
# Suitable for privacy-sensitive scenarios; the model runs locally
# LLM_PROVIDER=local
# LOCAL_BASE_URL=http://localhost:11434/v1
# LOCAL_MODEL=qwen2.5:7b

# ---------- Processing options ----------
# Concurrent paragraphs (controls API rate and cost)
MAX_CONCURRENCY=4
# Whether to output AI labeling debug report
DEBUG_ANNOTATION=false

# ---------- Network ----------
# If the provider must be reached through a proxy, set it explicitly here
# (or export HTTPS_PROXY in your shell). The Windows system proxy is
# deliberately NOT used: it is often configured for something else and would
# silently capture API requests, producing a confusing "Connection error".
# LLM_PROXY=http://127.0.0.1:7890

# Request timeout in seconds (default 120)
# LLM_TIMEOUT=120

# Where to cache LLM responses (default .cache/papergroom).
# Set to an empty value to disable caching.
# LLM_CACHE_DIR=.cache/papergroom
